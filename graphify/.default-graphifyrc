# graphify default configuration
#
# This file ships with the graphify package and provides out-of-the-box
# defaults for all .graphifyrc-supported options. It is loaded first; a
# project-level .graphifyrc (in the repo root, next to .graph/)
# then overrides any key it sets, so per-project config wins over defaults.
#
# To customize for your project, create a .graphifyrc in your repo root
# (NOT .default-graphifyrc — that name is reserved for the shipped default).
# Only put the keys you want to override; everything else falls back here.
#
# See docs/hybrid-semantic-search/Embedding.md for the embedding options.

# --- Visualization -----------------------------------------------------------
# Skip HTML generation when the graph exceeds this node count (0 = never skip,
# negative = always skip). Large graphs produce HTML files that browsers
# struggle to open. Set per-project in .graphifyrc to override.
# viz_node_limit = 0

# --- Hybrid Semantic Search (embedding) -------------------------------------
# The embedding backend for the vector tier of hybrid search. When unset (the
# default), HybridScorer.available stays False and queries run in pure-lexical
# mode — graphify works fully without an embedding model configured.
#
# To enable hybrid search out of the box, uncomment one of the backends below
# and set its embed_base_url / embed_api_key (or use the backend-specific
# env vars documented in Embedding.md).
#
# Self-hosted OpenAI-compatible endpoint (vLLM / LM Studio / llama.cpp):
# embed_backend = openai-compatible
# embed_base_url = http://localhost:8080/v1
# embed_api_key = local
# embed_model = text-embedding-3-small
#
# Local Ollama (requires `ollama serve` + `ollama pull nomic-embed-text`):
# embed_backend = ollama
#
# OpenAI cloud:
# embed_backend = openai
# embed_api_key = sk-...
# embed_model = text-embedding-3-small
#
# sentence-transformers (test/CI only, in-process PyTorch CPU, no API):
# embed_backend = sentence-transformers
# embed_model = paraphrase-multilingual-MiniLM-L12-v2

# --- Embedding Proxy Control ------------------------------------------------
# Embedding requests default to DIRECT CONNECT (bypass system/env proxies).
# This avoids a Windows + httpx bug where the system proxy bypass list
# ("不代理"/"代码黑名单") is silently dropped, routing directly-reachable
# embedding endpoints through a proxy that can't reach them.
#
# Set to true ONLY when your embedding endpoint requires a proxy:
#   enable_embedding_proxy = true
#
# Default (unset / false): embedding requests connect directly to
# embed_base_url, ignoring HTTP_PROXY/HTTPS_PROXY env vars and the Windows
# system proxy registry.
