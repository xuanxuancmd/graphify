# graphify embedding config for user-management test fixture
#
# This enables sentence-transformers (local CPU, no API key, no external
# service) so hybrid semantic search works end-to-end during manual
# verification and the test suite. The model is small (~470MB) and runs
# in-process via PyTorch CPU.
#
# Without this file, graphify silently skips embedding generation: the main
# build pipeline (build_from_json -> to_json -> report) never invokes the
# embedder. Embeddings are only generated by `graphify check` (the
# SessionStart staleness hook) or an explicit Python call to
# generate_embeddings_for_graph(), and BOTH paths early-return when
# embed_backend is unset (cli.py:1057-1058).
#
# Lookup order (hybrid_scorer.py:37-89):
#   1. .default-graphifyrc  (shipped with the package, embed_backend unset)
#   2. .graph/graphifyrc    (THIS file — per-project override)
#   3. env vars             (deprecated, no longer read)
# This file wins over the shipped default, so embed_backend becomes set.

embed_backend=sentence-transformers
embed_model=paraphrase-multilingual-MiniLM-L12-v2
